{
  "name": "@specstride/host-dsh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The dsh host of Specstride (specs/120-host-dsh): a thin layer over the one Specstride engine on the host port EP-01 (specstride.host/1), with the skills specstride-run, specstride-reverse and specstride-doctor, a standalone shim, an installer with an install record, and the six host.* doctor checks. Everything of the engine arrives through the pinned core tarballs in vendor/core/; the kanban tab is specs/121-dsh-kanban.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "specstride-host-dsh": "bin/specstride-host-dsh.mjs",
    "specstride-dsh": "bin/specstride.mjs"
  },
  "files": [
    "bin/",
    "skills/"
  ],
  "specstride": {
    "protocol": {
      "min": 1,
      "max": 1
    },
    "engineVersion": "0.1.0"
  },
  "scripts": {
    "pin": "node scripts/core-pin.mjs",
    "pin:check": "node scripts/core-pin.mjs --check",
    "build": "node --experimental-strip-types scripts/build.ts",
    "test": "node --experimental-strip-types --test tests/core-smoke.test.mjs \"tests/**/*.test.mjs\" \"tests/**/*.test.ts\"",
    "conformance": "node --experimental-strip-types scripts/conformance.ts"
  },
  "dependencies": {
    "@specstride/contracts": "file:vendor/core/specstride-contracts-0.1.0.tgz",
    "@specstride/host-kit": "file:vendor/core/specstride-host-kit-0.1.0.tgz"
  },
  "devDependencies": {
    "@specstride/testkit": "file:vendor/core/specstride-testkit-0.1.0.tgz",
    "specstride": "file:vendor/core/specstride-0.1.0.tgz"
  }
}
